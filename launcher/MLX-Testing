#!/usr/bin/env bash
# MLX-Testing global launcher.
set -euo pipefail
REPO="$HOME/Documents/LLM-MLX-Test"
export PATH="$HOME/.local/bin:$PATH"
bash "$REPO/setup.sh" --check-only >/dev/null || bash "$REPO/setup.sh"
pkill -f "ollama serve" >/dev/null 2>&1 || true
ollama serve >/tmp/mlx-testing-ollama.log 2>&1 &
SERVE_PID=$!
trap 'kill $SERVE_PID 2>/dev/null || true' EXIT INT TERM
for _ in $(seq 1 30); do curl -sf --max-time 2 http://localhost:11434/api/tags >/dev/null && break; sleep 1; done
set +e
"$REPO/venv/bin/python" "$REPO/duel.py" "$@"
CODE=$?
set -e
if [ "$CODE" = 42 ]; then ollama rm qwen2.5:0.5b || true; echo "Deleted local Ollama test blob. Next run re-pulls it."; CODE=0; fi
exit "$CODE"
